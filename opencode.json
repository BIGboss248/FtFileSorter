{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dart-flutter-mcp": {
        "type": "local",
        "command": [
          "dart",
          "mcp-server"
        ]
      },
      "developer-knowledge": {
        "type": "remote",
        "url": "https://developerknowledge.googleapis.com/mcp",
        "headers": {
          "X-Goog-Api-Key": "{env:GOOGLE_API_KEY}"
        }
      }
    }
  }
}
